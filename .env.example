BOT_TOKEN=

# Optional: a Discord user ID that passes every permission check.
# The server owner already does.
# OWNER_ID=

# Web dashboard. On Pterodactyl it uses the server's own port automatically.
# The admin password is generated on first start and printed in the console,
# unless you choose one here.
# DASHBOARD_PASSWORD=
# Public address, for the links /dashboard sends (e.g. https://ditto.example.com):
# DASHBOARD_URL=
# DASHBOARD=0 turns it off.
